#!/bin/sh
# Before a push to GitHub, where the history is public, checks every commit
# not yet there: its author and committer, message and added lines.
case "$2" in
*github.com*) ;;
*) exit 0 ;;
esac
zero=0000000000000000000000000000000000000000
ok=0
while read -r lref lsha rref rsha; do
	[ "$lsha" = "$zero" ] && continue # a branch deleted
	"$(dirname "$0")/check.sh" commits "$lsha" --not --remotes="$1" || ok=1
done
if [ "$ok" != 0 ]; then
	echo "pre-push: these commits are not for $2; reword them, or push with --no-verify." >&2
fi
exit $ok
