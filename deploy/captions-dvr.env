# /etc/captions-dvr/captions-dvr.env
PORT=8095
# URL Channels DVR uses to reach this relay (written into playlist.m3u)
PUBLIC_URL=http://dvr-host:8095
# Sources and channel selection, edited in the web page at http://<host>:PORT/
CHANNELS_FILE=/var/lib/captions-dvr/channels.json
# remote: ASR on the Mac (see README "ASR HTTP contract"); none: remux only
ASR_BACKEND=remote
ASR_URL=http://asr-host:8096
ASR_TIMEOUT=15
DELAY=20
GRACE=60
# Optional: where "Keep audio archive" (web page, off by default) keeps the last
# hour of ASR chunks (audio + raw output) for debugging
#ARCHIVE_DIR=/var/lib/captions-dvr/archive
#ARCHIVE_MINUTES=60
# English programme guide (epg.xml), translated on this machine's CPU with
# NLLB-200. 1 = on: the model (1.4 GB) downloads by itself the first time,
# into /var/lib/captions-dvr/models (or fetch it first: sudo captions-dvr-get-nllb).
EPG_TRANSLATE=0
